<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MMOnsterpatchOfficialServerPatcher</AssemblyName>
    <RootNamespace>Goose.Monsterpatch.MMOnsterpatchOfficialServer</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.19.11</Version>
    <AssemblyVersion>0.19.11.0</AssemblyVersion>
    <FileVersion>0.19.11.0</FileVersion>
    <InformationalVersion>v0.19.11-ScreenshotMultipartFix</InformationalVersion>
    <!-- Suppress known harmless warnings from Unity/reflection DTO fields and retained UI state placeholders. -->
    <NoWarn>$(NoWarn);0649;0414;0169</NoWarn>
    <OutputPath>bin\$(Configuration)\net472\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ReferenceLibDir Condition="'$(MONSTERPATCH_LIB_DIR)' != ''">$(MONSTERPATCH_LIB_DIR)</ReferenceLibDir>
    <ReferenceLibDir Condition="'$(ReferenceLibDir)' == ''">$(MSBuildProjectDirectory)\..\lib</ReferenceLibDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(ReferenceLibDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Net.Http"><HintPath>$(ReferenceLibDir)\System.Net.Http.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Runtime.Serialization"><HintPath>$(ReferenceLibDir)\System.Runtime.Serialization.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ReferenceLibDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ReferenceLibDir)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ReferenceLibDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(ReferenceLibDir)\Mono.Cecil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ReferenceLibDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ReferenceLibDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ReferenceLibDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ReferenceLibDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\OnlinemenuBG.png" />
    <EmbeddedResource Include="Assets\SatsCoinIcon.png" />
    <EmbeddedResource Include="Assets\MMOnsterpatchTitleLogo.png" />
    <EmbeddedResource Include="Assets\MMOnsterpatchSaveFilePlus.png" />
    <EmbeddedResource Include="Assets\OnlinelegendaryBG.png" />
    <EmbeddedResource Include="Assets\OnlinehouseIcon1.png" />
    <EmbeddedResource Include="Assets\MailboxIcon.png" />
  </ItemGroup>

  <!-- Publish must embed the freshly built patcher, never an older payload. -->
  <Target Name="CopyBuiltPatcherToLauncherPayload" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\Launcher\MMOnsterpatchLauncher.Wpf')">
    <PropertyGroup>
      <LauncherPayloadPatchers>$(MSBuildProjectDirectory)\..\..\Launcher\MMOnsterpatchLauncher.Wpf\Payload\BepInEx\patchers\</LauncherPayloadPatchers>
      <BuiltPatcherPdb>$(TargetDir)$(TargetName).pdb</BuiltPatcherPdb>
    </PropertyGroup>
    <MakeDir Directories="$(LauncherPayloadPatchers)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LauncherPayloadPatchers)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(BuiltPatcherPdb)" DestinationFolder="$(LauncherPayloadPatchers)" SkipUnchangedFiles="false" Condition="Exists('$(BuiltPatcherPdb)')" />
  </Target>

  <Target Name="CopyBuiltPatcherToCrossPlatformLauncherPayloads" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\Launcher\Payloads')">
    <PropertyGroup>
      <CrossPlatformLauncherDir>$(MSBuildProjectDirectory)\..\..\Launcher</CrossPlatformLauncherDir>
      <CrossPlatformWinPatchers>$(CrossPlatformLauncherDir)\Payloads\win-x64\BepInEx\patchers\</CrossPlatformWinPatchers>
      <CrossPlatformLinuxPatchers>$(CrossPlatformLauncherDir)\Payloads\linux-x64\BepInEx\patchers\</CrossPlatformLinuxPatchers>
      <BuiltPatcherPdb>$(TargetDir)$(TargetName).pdb</BuiltPatcherPdb>
    </PropertyGroup>
    <MakeDir Directories="$(CrossPlatformWinPatchers);$(CrossPlatformLinuxPatchers)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CrossPlatformWinPatchers)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CrossPlatformLinuxPatchers)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(BuiltPatcherPdb)" DestinationFolder="$(CrossPlatformWinPatchers)" SkipUnchangedFiles="false" Condition="Exists('$(BuiltPatcherPdb)')" />
    <Copy SourceFiles="$(BuiltPatcherPdb)" DestinationFolder="$(CrossPlatformLinuxPatchers)" SkipUnchangedFiles="false" Condition="Exists('$(BuiltPatcherPdb)')" />
    <Message Importance="high" Text="MMOnsterpatch cross-platform payload copy: $(TargetFileName) -> Launcher\Payloads\win-x64 and linux-x64." />
  </Target>

</Project>
