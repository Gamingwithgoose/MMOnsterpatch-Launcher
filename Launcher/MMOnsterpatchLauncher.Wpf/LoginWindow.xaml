<Window x:Class="MMOnsterpatchLauncher.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Log In"
        Width="420"
        Height="405"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#080B10"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F00A0F14" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A4652" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECECEC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8BCC3" />
        <SolidColorBrush x:Key="PurpleAccentBrush" Color="#9A4DED" />
        <SolidColorBrush x:Key="PurpleAccentLightBrush" Color="#DEC5FF" />
        <SolidColorBrush x:Key="OnlineGreenBrush" Color="#2DE342" />

        <DropShadowEffect x:Key="PurpleGlow" BlurRadius="14" ShadowDepth="0" Opacity="0.40" Color="#9A4DED" />

        <LinearGradientBrush x:Key="PurpleButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B15BFF" Offset="0" />
            <GradientStop Color="#8D39E6" Offset="0.50" />
            <GradientStop Color="#5A2197" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#151B23" />
            <Setter Property="BorderBrush" Value="#39434F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="CaretBrush" Value="{StaticResource PurpleAccentLightBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#151B23" />
            <Setter Property="BorderBrush" Value="#39434F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="CaretBrush" Value="{StaticResource PurpleAccentLightBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PurplePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource PurpleButtonBrush}" />
            <Setter Property="BorderBrush" Value="#B77BFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource PurpleGlow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PurpleAccentLightBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,0,4,0" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10"
            BorderBrush="#563489"
            BorderThickness="1"
            Background="{StaticResource PanelBrush}">
        <Grid>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Height="42" VerticalAlignment="Top" Background="#EA0D1117">
                <TextBlock Text="MMOnsterpatch Account"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0" />
                <Button x:Name="CloseLoginButton"
                        Content="×"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,10,0"
                        Style="{StaticResource ChromeButtonStyle}"
                        Click="CloseLoginButton_Click" />
            </Grid>

            <StackPanel Margin="32,68,32,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Grid Width="44" Height="44" Margin="0,0,14,0">
                        <Ellipse Fill="#1A2028" Stroke="{StaticResource PurpleAccentLightBrush}" StrokeThickness="1" />
                        <Image Source="Assets/ProfileIcon.png" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse x:Name="LoginStatusDot" Width="10" Height="10" Fill="#7B8088" Stroke="#0A0F14" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Log In"
                                   Foreground="{StaticResource PurpleAccentLightBrush}"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="MMOnsterpatch Server Account"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Username / Email address"
                           Foreground="{StaticResource PurpleAccentLightBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBox x:Name="UsernameEmailTextBox"
                         Style="{StaticResource LoginTextBoxStyle}"
                         Margin="0,0,0,14" />

                <TextBlock Text="Password"
                           Foreground="{StaticResource PurpleAccentLightBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInputBox"
                             Style="{StaticResource LoginPasswordBoxStyle}"
                             Margin="0,0,0,12" />

                <Grid Margin="0,0,0,18">
                    <CheckBox x:Name="RememberMeCheckBox"
                              Content="Remember Me"
                              Foreground="{StaticResource TextBrush}"
                              FontSize="12.5"
                              VerticalAlignment="Center" />
                    <Button x:Name="ForgotPasswordButton"
                            Content="Forgot Password"
                            Style="{StaticResource TextLinkButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ForgotPasswordButton_Click" />
                </Grid>

                <Button x:Name="RegisterButton"
                        Content="Register"
                        Style="{StaticResource TextLinkButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,-10,0,6"
                        Click="RegisterButton_Click" />
                <Button x:Name="LoginButton"
                        Content="LOG IN"
                        Style="{StaticResource PurplePrimaryButtonStyle}"
                        Click="LoginButton_Click" />

                <TextBlock x:Name="LoginMessageText"
                           Text=""
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11.5"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
