<Window x:Class="MMOnsterpatchLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MMOnsterpatch Launcher"
        Width="1050"
        Height="680"
        MinWidth="900"
        MinHeight="585"
        MaxWidth="1920"
        MaxHeight="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080B10"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        d:DesignWidth="1050"
        d:DesignHeight="680">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="PurpleAccentColor">#9A4DED</Color>
        <Color x:Key="PurpleAccentLightColor">#DEC5FF</Color>
        <Color x:Key="OnlineGreenColor">#2DE342</Color>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#080B10" />
        <SolidColorBrush x:Key="PanelBrush" Color="#D90A0F14" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#35404C" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECECEC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8BCC3" />
        <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource PurpleAccentColor}" />
        <SolidColorBrush x:Key="PurpleAccentLightBrush" Color="{StaticResource PurpleAccentLightColor}" />
        <SolidColorBrush x:Key="OnlineGreenBrush" Color="{StaticResource OnlineGreenColor}" />
        <DropShadowEffect x:Key="SoftPanelShadow" BlurRadius="12" ShadowDepth="0" Opacity="0.34" Color="#000000" />
        <DropShadowEffect x:Key="PurpleGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.42" Color="#9A4DED" />
        <LinearGradientBrush x:Key="PurpleButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B15BFF" Offset="0" />
            <GradientStop Color="#8D39E6" Offset="0.48" />
            <GradientStop Color="#5A2197" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CB8CFF" Offset="0" />
            <GradientStop Color="#A85AFF" Offset="0.48" />
            <GradientStop Color="#7130B8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7130B8" Offset="0" />
            <GradientStop Color="#A85AFF" Offset="0.55" />
            <GradientStop Color="#DEC5FF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#262C35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333B47" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#634099" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource PurpleGlow}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PurpleAccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PurplePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource PurpleButtonBrush}" />
            <Setter Property="BorderBrush" Value="#B77BFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="7" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PurpleButtonHoverBrush}" />
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource PurpleGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PurpleOutlineButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PurpleAccentLightBrush}" />
            <Setter Property="Background" Value="#22101722" />
            <Setter Property="BorderBrush" Value="{StaticResource PurpleAccentLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33244A33" />
                                <Setter TargetName="Root" Property="Effect" Value="{StaticResource PurpleGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E80A0F14" />
            <Setter Property="BorderBrush" Value="#39434F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#55616E" />
                                <Setter TargetName="Root" Property="Background" Value="#F00D141C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MMRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Ellipse Stroke="#7F8791" StrokeThickness="1.5" Fill="#10151B" />
                                <Ellipse x:Name="CheckedDot" Width="8" Height="8" Fill="{StaticResource PurpleAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckedDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MMProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource PurpleProgressBrush}" />
            <Setter Property="Background" Value="#222A31" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBgBrush}" ClipToBounds="True">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="DesignCanvas" Width="1050" Height="680" Background="#080B10">
                <Border x:Name="TitleBarDragArea" Canvas.Left="0" Canvas.Top="0" Width="1050" Height="34" Background="#EA0D1117" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <Image Source="Assets/MMOnsterpatchLauncherIcon.png" Canvas.Left="11" Canvas.Top="8" Width="18" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Canvas.Left="38" Canvas.Top="7" Text="MMOnsterpatch Launcher" Foreground="{StaticResource TextBrush}" FontSize="14" />
                <Button x:Name="MinimizeButton" Canvas.Left="925" Canvas.Top="2" Content="—" Click="Minimize_Click" Style="{StaticResource ChromeButtonStyle}" />
                <Button x:Name="MaximizeButton" Canvas.Left="970" Canvas.Top="2" Content="□" Click="Maximize_Click" Style="{StaticResource ChromeButtonStyle}" />
                <Button x:Name="CloseButton" Canvas.Left="1012" Canvas.Top="2" Content="×" Click="Close_Click" Style="{StaticResource ChromeButtonStyle}" />

                <Grid x:Name="HeaderBanner" Canvas.Left="0" Canvas.Top="34" Width="1050" Height="165" ClipToBounds="True">
                    <Image x:Name="HeaderForestImage" Source="Assets/HeaderForest.png" Width="1050" Height="165" Stretch="Fill" />
                    <Rectangle Fill="#3F070B10" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#AA080B10" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Image x:Name="MainTitleLogo" Source="Assets/MMOnsterpatchTitleLogo.png" Canvas.Left="45" Canvas.Top="55" Width="505" Height="118" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <Button x:Name="DiscordButton" Canvas.Left="795" Canvas.Top="47" Background="#191E24" Style="{StaticResource IconButtonStyle}" ToolTip="Discord" Click="DiscordButton_Click">
                    <Image Source="Assets/DiscordIcon.png" Width="27" Height="27" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button x:Name="GitHubButton" Canvas.Left="850" Canvas.Top="47" Background="#191E24" Style="{StaticResource IconButtonStyle}" ToolTip="GitHub" Click="GitHubButton_Click">
                    <Image Source="Assets/GitHubIcon.png" Width="27" Height="27" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button x:Name="ProfileButton" Canvas.Left="905" Canvas.Top="47" Background="#191E24" Style="{StaticResource IconButtonStyle}" ToolTip="Profile / Log In" Click="ProfileButton_Click">
                    <Grid Width="38" Height="38">
                        <Image Source="Assets/ProfileIcon.png" Width="25" Height="25" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse x:Name="ProfileStatusDot" Width="9" Height="9" Fill="#7B8088" Stroke="#0A0F14" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" />
                    </Grid>
                </Button>
                <Popup x:Name="ProfileFlyout" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="304" MinHeight="292" MaxHeight="390" CornerRadius="10" Background="#F20A0F14" BorderBrush="#563489" BorderThickness="1" Padding="16" Effect="{StaticResource SoftPanelShadow}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Grid Width="54" Height="54" Margin="0,0,13,0">
                                    <Ellipse Fill="#1A2028" Stroke="{StaticResource PurpleAccentLightBrush}" StrokeThickness="1" />
                                    <Image Source="Assets/ProfileIcon.png" Width="35" Height="35" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Ellipse x:Name="ProfileFlyoutStatusDot" Width="11" Height="11" Fill="#2DE342" Stroke="#0A0F14" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Width="200">
                                    <TextBlock x:Name="ProfileFlyoutNameText" Text="Not signed in" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProfileFlyoutAccountText" Text="Log in to continue" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="MMOnsterpatch Account" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="1,0,0,8" />
                            <Button x:Name="ViewProfileButton" Content="View Profile" Height="36" Margin="0,0,0,8" Style="{StaticResource PurpleOutlineButtonStyle}" Click="ViewProfileButton_Click" />
                            <Button x:Name="ManageAccountButton" Content="Manage Account" Height="36" Margin="0,0,0,8" Style="{StaticResource PurpleOutlineButtonStyle}" Click="ManageAccountButton_Click" />
                            <Button x:Name="LogoutButton" Content="Log Out" Height="36" Margin="0,4,0,0" Style="{StaticResource PurplePrimaryButtonStyle}" Click="LogoutButton_Click" />

                            <Border Height="1" Background="#313844" Margin="0,14,0,10" />
                            <TextBlock Text="Online Play uses this launcher account to play on the MMOnsterpatch servers." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="InfoButton" Canvas.Left="960" Canvas.Top="47" Content="ℹ" Background="#191E24" Style="{StaticResource IconButtonStyle}" ToolTip="Info" Click="InfoButton_Click" />

                <Button x:Name="ServerStatusButton" Canvas.Left="776" Canvas.Top="106" Width="230" Height="68" Style="{StaticResource StatusCardButtonStyle}" Click="ServerStatusButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="0,0,0,-23">
                        <Ellipse x:Name="ServerStatusDot" Width="10" Height="10" Fill="{StaticResource OnlineGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,7,0,0" />
                        <TextBlock x:Name="ServerStatusHeaderText" Text="SERVER STATUS" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="42,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock x:Name="ServerStatusOnlineText" Text="ONLINE" Foreground="{StaticResource OnlineGreenBrush}" FontSize="16" FontWeight="Bold" Margin="42,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" />
                        <TextBlock x:Name="PlayersOnlineText" Text="Players Online: 0" Foreground="{StaticResource TextBrush}" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="41,44,0,0" />
                    </Grid>
                </Button>

                <Rectangle Canvas.Left="0" Canvas.Top="199" Width="1050" Height="481" Fill="#080B10" />

                <Border x:Name="NewsPanel" Canvas.Left="12" Canvas.Top="208" Width="302" Height="386" CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Effect="{StaticResource SoftPanelShadow}">
                    <Grid>
                        <TextBlock Text="NEWS" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="17" FontWeight="Bold" Margin="20,13,0,0" />
                        <Button x:Name="ViewAllNewsButton" Content="View All" Foreground="{StaticResource PurpleAccentLightBrush}" Background="Transparent" BorderBrush="Transparent" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,14,0" Click="ViewAllNewsButton_Click" />
                        <Line X1="0" Y1="46" X2="302" Y2="46" Stroke="#313844" StrokeThickness="1" />
                        <StackPanel Margin="20,58,28,0">
                            <TextBlock Text="Welcome to MMOnsterpatch UnOfficial Server!" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="7/4/2026" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,5,0,0" />
                            <TextBlock Text="Welcome to the unofficial server! Make sure to join our Discord for updates and announcements." Foreground="{StaticResource TextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,6,0" />
                            <Rectangle Height="1" Fill="#313844" Margin="0,14,0,12" />
                            <TextBlock Text="Server Launch Date" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="12.5" FontWeight="Bold" />
                            <TextBlock Text="To Be Announced" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,5,0,0" />
                            <TextBlock Text="The unofficial server is planned for release soon." Foreground="{StaticResource TextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,6,0" />
                            <Rectangle Height="1" Fill="#313844" Margin="0,14,0,12" />
                            <TextBlock Text="If you encounter any issues, please report them in our Discord." Foreground="{StaticResource TextBrush}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="VisitWebsiteButton" Content="↗   Visit Website" Style="{StaticResource PurpleOutlineButtonStyle}" FontSize="14" Width="260" Height="38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,22" Click="VisitWebsiteButton_Click" />
                    </Grid>
                </Border>

                <Border x:Name="FeatureScreenshotPanel" Canvas.Left="326" Canvas.Top="208" Width="708" Height="326" CornerRadius="8" Background="#10151B" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" ClipToBounds="True" Effect="{StaticResource SoftPanelShadow}">
                    <Grid ClipToBounds="True">
                        <Image x:Name="FeatureScreenshotImage" Source="Assets/FeatureScreenshot.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Grid>
                </Border>

                <Border x:Name="PlayOptionsPanel" Canvas.Left="326" Canvas.Top="545" Width="708" Height="52" CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid Margin="0,0,0,-1">
                        <TextBlock Text="Supported Game Version" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="12" FontWeight="Bold" Margin="17,8,0,0" />
                        <Border x:Name="GameVersionDropdownVisual" Margin="17,25,0,0" Width="205" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Background="#1A2028" BorderBrush="#39434F" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="Monsterpatch v0.182" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="9,0,0,1" />
                            </Grid>
                        </Border>
                        <TextBlock Text="PLAY MODE" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="12" FontWeight="Bold" Margin="265,8,0,0" />
                        <RadioButton x:Name="OnlineRadioButton" Content="Online" IsChecked="True" GroupName="PlayMode" Style="{StaticResource MMRadioStyle}" Margin="265,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <RadioButton x:Name="OfflineRadioButton" Content="Offline" GroupName="PlayMode" Style="{StaticResource MMRadioStyle}" Margin="350,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Button x:Name="PlayButton" Style="{StaticResource PurplePrimaryButtonStyle}" Width="210" Height="34" Margin="0,8,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Play_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PLAY" FontSize="18" FontWeight="Bold" Margin="0,0,18,0" />
                                <TextBlock Text="▶" FontSize="17" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="UpdateStatusPanel" Canvas.Left="12" Canvas.Top="606" Width="1022" Height="38" CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="UpdateStatusText" Text="Ready to play!" Foreground="{StaticResource PurpleAccentLightBrush}" FontSize="12" Margin="18,7,0,0" />
                        <ProgressBar x:Name="UpdateProgressBar" Width="675" Height="8" Minimum="0" Maximum="100" Value="0" Style="{StaticResource MMProgressBarStyle}" Margin="18,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock x:Name="UpdateProgressText" Text="0%" Foreground="{StaticResource TextBrush}" FontSize="11.5" Margin="705,18,0,0" />
                        <Button x:Name="CheckForUpdatesButton" Content="⟳   Check for Updates" Style="{StaticResource PurpleOutlineButtonStyle}" FontSize="12.5" Width="178" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,14,0" Click="CheckForUpdates_Click" />
                    </Grid>
                </Border>

                <Rectangle Canvas.Left="0" Canvas.Top="655" Width="1050" Height="1" Fill="#2A3038" />
                <Border x:Name="FooterPanel" Canvas.Left="0" Canvas.Top="656" Width="1050" Height="24" Background="#D2080D12" />
                <Button x:Name="OpenLogsButton" Canvas.Left="703" Canvas.Top="659" Content="▧  Open Logs" Style="{StaticResource PurpleOutlineButtonStyle}" FontSize="11" Width="112" Height="18" Click="OpenLogsButton_Click" />
                <Button x:Name="OpenGameFolderButton" Canvas.Left="826" Canvas.Top="659" Content="▰  Open Game Folder" Style="{StaticResource PurpleOutlineButtonStyle}" FontSize="11" Width="154" Height="18" Click="OpenGameFolderButton_Click" />
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
